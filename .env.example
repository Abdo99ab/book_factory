_OPENAI_API_KEY=replace-with-openai-api-key
FLASK_SECRET_KEY=replace-with-a-long-random-value
TEXT_MODEL=gpt-6-luna
IMAGE_MODEL=gpt-image-2.5-flare
PAGE_CONCURRENCY=1
JOB_CONCURRENCY=1
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MAX_ATTEMPTS=3
# Humanize manuscript + page text with blader/humanizer via OpenAI Skills API
HUMANIZE_STORY=1
HUMANIZE_VIA_SKILLS_API=1
